{
  "name": "rcm-whatsapp-notifier",
  "version": "0.1.0",
  "description": "Scans Rental Car Manager bookings and sends WhatsApp messages at key points of the customer journey.",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js watch",
    "webhook": "node --disable-warning=ExperimentalWarning src/index.js webhook",
    "all": "node --disable-warning=ExperimentalWarning src/index.js all",
    "run-once": "node --disable-warning=ExperimentalWarning src/index.js run",
    "dry-run": "node --disable-warning=ExperimentalWarning src/index.js run --dry-run",
    "test": "node --test test/*.test.js"
  },
  "optionalDependencies": {
    "pg": "^8.13.1"
  },
  "license": "UNLICENSED",
  "private": true
}
