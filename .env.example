# ---------- General ----------
# Where bookings come from: "rcm" (live Rental Car Manager API) or "file" (data/sample-bookings.json for testing)
BOOKING_SOURCE=file
BOOKINGS_FILE=data/sample-bookings.json
# Local timezone offset of booking times (Gold Coast / Brisbane = +10:00, no daylight saving)
TIMEZONE_OFFSET=+10:00
# How often "watch" mode scans bookings (minutes)
SCAN_INTERVAL_MINUTES=15
# true = log what would be sent but don't send anything
DRY_RUN=true
# Business details used in messages
BUSINESS_NAME=Your Car Rentals
BUSINESS_PHONE=+61 7 0000 0000
# Link customers use to upload licence / fill in docs (use {ref} to insert the booking reference)
DOCS_URL=https://example.com/checkin?ref={ref}

# ---------- Rental Car Manager ----------
RCM_BASE_URL=https://apis.rentalcarmanager.com
RCM_BOOKINGS_PATH=/booking/v3.2/bookings
RCM_API_KEY=
RCM_SECRET_KEY=

# ---------- WhatsApp (Meta WhatsApp Cloud API) ----------
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# "template" (required for business-initiated messages) or "text" (only works inside the 24h customer-service window)
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------- Airport pickup infographics ----------
# Must be public HTTPS URLs (or swap for uploaded WhatsApp media IDs)
INFOGRAPHIC_OOL_URL=https://example.com/infographics/gold-coast-airport-pickup.jpg
INFOGRAPHIC_BNE_URL=https://example.com/infographics/brisbane-airport-pickup.jpg
